      given-names: Igor
    - family-names: Vetter
      given-names: Leonard
  journal: Electronic Communications in Probability
  volume: 30
  year: 2025
  number: 79
  doi: 10.1214/25-ECP726
  url: https://doi.org/10.1214/25-ECP726
